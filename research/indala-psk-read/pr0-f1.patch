  * Write card data to t55xx
  */
 static uint8_t write_t55xx(uint32_t *blks, uint8_t blk_count, uint8_t *new_passwd, uint8_t *old_passwds, uint8_t old_passwd_count) {
-    uint32_t passwd = bytes_to_num(new_passwd, 4);
+    const uint32_t passwd = (uint32_t)bytes_to_num(new_passwd, 4);
+    const bool set_pwd = (passwd != 0);
+
+    /* ⛔ PASSWORD PROTECTION IS OPT-IN. The bit lives in block 0, and it used to arrive there
+     * from the config constants, so every write enabled it whether or not a key was asked
+     * for. Set it here and only when a non-zero key was actually supplied. */
+    if (set_pwd && blk_count > 0) {
+        blks[0] |= T5577_PWD;
+    }
 
     start_lf_125khz_radio();
     bsp_delay_ms(1);  // Delays for a while after starting the field
 
