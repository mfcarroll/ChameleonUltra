+    }
     t55xx_write_data(passwd, blks, blk_count);
 
     stop_lf_125khz_radio();
diff --git a/software/script/chameleon_cmd.py b/software/script/chameleon_cmd.py
index 168836c3..16140afd 100644
--- a/software/script/chameleon_cmd.py
+++ b/software/script/chameleon_cmd.py
@@ -10,8 +10,13 @@ from chameleon_enum import MfcKeyType, MfcValueBlockOperator
 
 CURRENT_VERSION_SETTINGS = 6
 
-new_key = b'\x20\x20\x66\x66'
-old_keys = [b'\x51\x24\x36\x48', b'\x19\x92\x04\x27']
+# ⛔ A WRITE MUST NOT SET A PASSWORD THE USER DID NOT ASK FOR. `new_key` used to be
+# 20206666, so every `lf * write` password-protected the tag; the four raw-frame writers
+# carried a DIFFERENT key as a function default, so a tag locked by one could not be
+# rewritten by another, by the Proxmark, or by anything else. Zero means "do not protect".
+# The old keys stay in `old_keys` so tags already locked in the field can still be opened.
+new_key = b'\x00\x00\x00\x00'
+old_keys = [b'\x20\x20\x66\x66', b'\x51\x24\x36\x48', b'\x19\x92\x04\x27']
 
 
